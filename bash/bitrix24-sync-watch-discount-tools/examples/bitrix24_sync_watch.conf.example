# /etc/bitrix24_sync_watch.conf - root:root 0600
# Site-specific settings, no passwords or API tokens.
SITE_NAME="discount-tools.ru"

# IMPORTANT: confirm the actual log path on production with nginx -T.
ACCESS_LOG="/var/log/nginx/access.log"
EXCHANGE_PATH="/bitrix/admin/1c_exchange.php"
B24_USER="bx_eshop"
# 1: only count HTTP 200 requests with ' - bx_eshop ' in nginx combined log.
# Set 0 ONLY if Bitrix24 requests do not log the username; this is less reliable.
REQUIRE_LOG_USER=1
SYNC_PERIOD_MIN=10
ALERT_AFTER=1500
MAX_ROTATED=2

STATE_FILE="/var/lib/bitrix24-sync-watch/state"
MONITOR_LOG="/var/log/bitrix24_sync_watch.log"
LOCK_FILE="/run/lock/bitrix24_sync_watch.lock"

MAIL_ENABLED=1
SENDMAIL="/usr/sbin/sendmail"
EMAIL_FROM="info@discount-tools.ru"
EMAIL_TO="adm+site@kanuk.su"
